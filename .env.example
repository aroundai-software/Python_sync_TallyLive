TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_BASE_CURRENCY=INR
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=use_the_key_from_your_existing_private_configuration
SYNC_INTERVAL=3600
SYNC_VALIDITY=1y
# Set to 1 for a one-off full re-read that ignores incremental bookmarks.
FULL_RECONCILE=0
# Optional: sync a specific financial year instead of the current one, e.g. 2025
# SYNC_START_YEAR=
