TALLY_HOST=localhost
TALLY_PORT=9000
SYNC_INTERVAL=3600
SYNC_VALIDITY=1y
# Set to 1 for a one-off full re-read that ignores incremental bookmarks.
FULL_RECONCILE=0
# Balance Sheet / P&L: heavy Tally reports. Runs twice per day:
#   1) first sync of the local calendar day
#   2) once at a random time between 2:00 PM and 4:00 PM local
# Remote/cloud Tally waits longer by default (360s x 2 HTTP retries) so BS/P&L can finish.
# Soft same-day retries: up to 3 attempts/slot with ~50 min delay (not every hour).
# If Tally returns empty BS+P&L, skip that company for N days then re-check
# (FINANCIAL_REPORTS_UNAVAILABLE_DAYS=7). FULL_RECONCILE=1 clears the skip and retries.
# Optional: FINANCIAL_REPORTS_REMOTE_TIMEOUT=360  FINANCIAL_REPORTS_REMOTE_RETRIES=2
# FR failures are non-fatal for sync_logs status (core books sync can still be completed).
# Set FINANCIAL_REPORTS=0 to disable. FULL_RECONCILE=1 forces a run that cycle.
FINANCIAL_REPORTS=1
# FINANCIAL_REPORTS_UNAVAILABLE_DAYS=7
# Optional: sync a specific financial year instead of the current one, e.g. 2025
# SYNC_START_YEAR=

# Supabase URL / anon / service_role keys are hardcoded in src/config.py so the
# packaged EXE runs without putting secrets in this file. Keep .env for Tally
# host/port/interval and sync flags only.
